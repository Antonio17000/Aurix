

<!DOCTYPE html>

<html lang="it">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AURIX</title>

  <style>

    body {

      margin: 0;

      font-family: Arial, sans-serif;

      background: #10131c;

      color: white;

      min-height: 100vh;

      display: flex;

      justify-content: center;

      align-items: center;

      text-align: center;

    }

    .container {

      padding: 30px;

    }

    h1 {

      font-size: 48px;

      letter-spacing: 5px;

      color: #78aaff;

    }

    p {

      font-size: 18px;

      color: #d5d9e5;

    }

  </style>

</head>

<body>

  <div class="container">

    <h1>AURIX</h1>

    <p>Benvenuto in AURIX</p>
</div>

